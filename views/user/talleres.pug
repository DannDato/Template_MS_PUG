extends ../layouts/includes/index

block vars
    - var stepActivo = 'talleres'
    - var avisoFirmado = avisoFirmado || null;
    - var folder = folder || ''
block contenido
    
    - const diasOcupadosDB = []
    each t in talleresDia1
        if t.inscrito
            - diasOcupadosDB.push(1)
    each t in talleresDia2
        if t.inscrito
            - diasOcupadosDB.push(2)

    - const talleresCompletos = diasOcupadosDB.includes(1) && diasOcupadosDB.includes(2)

    if llRegistra === false
        div.mt-8.mx-auto(style="max-width: 750px;")
            div(class="max-w-4xl mx-auto mt-20 p-10 bg-white shadow-2xl rounded-2xl text-center border-t-4 border-yellow-500")
                div.mb-6
                    i.fas.fa-exclamation-circle.text-6xl.text-yellow-500
                h2.text-3xl.font-bold.text-gray-800.mb-4 Información Incompleta
                p.text-gray-600.text-lg.mb-8 No hemos detectado tu costo base o categoría de inscripción. Por favor, regresa y actualiza tu información personal antes de seleccionar talleres.
                a(href=`${folder}/user/info` class="inline-block bg-gray-800 text-white font-bold py-3 px-8 rounded-xl shadow-lg hover:bg-gray-900 transition transform hover:scale-105")
                    i.fas.fa-arrow-left.mr-2
                    | Editar Información
    else
        input(type="hidden" id="data-costo-base" value=costoBaseVisual)

        mixin cardTaller(taller, index, color, dia)
            - const estaInscrito = taller.inscrito === 1
            - const estaLleno = taller.estado === 'No disponible' && !estaInscrito
            
            div.call-card.flex.flex-col.bg-white.shadow-lg(
                style=`width: 100%; max-width: 280px; padding: 0; border-radius: 0 30px 0 30px; height: 100%; transition: all 0.3s; ${estaInscrito ? 'border: 2px solid #cbd5e1; opacity: 0.8;' : ''} ${estaLleno ? 'opacity: 0.7; filter: grayscale(1); pointer-events: none;' : ''}` 
                id=`card-${taller.id}`
            )
                if estaInscrito
                    span(class=`call-badge bg-gray-500 text-white` style="font-size: 0.7rem; padding: 4px 15px;") Inscrito
                else if estaLleno
                    span(class=`call-badge bg-red-600 text-white` style="font-size: 0.7rem; padding: 4px 15px; font-weight: bold;") CUPO LLENO
                else
                    span(class=`call-badge badge-${color}` style="font-size: 0.7rem; padding: 4px 15px;") Taller #{index + 1}
                
                div.call-content.flex.flex-col.h-full(style="padding: 1.5rem;")
                    h3.text-lg.leading-tight.mb-3(style="min-height: 50px; font-size: 1.1rem;")= taller.nombre
                    
                    div.date-block.mb-3(style="padding: 8px;")
                        i.fas.fa-user-circle(style="font-size: 1.5rem;")
                        div.flex.flex-col.leading-tight
                            if taller.tallerista_nombre
                                span.font-bold(style="font-size: 0.85rem;") #{taller.tallerista_nombre}
                                span.text-gray-500(style="font-size: 0.7rem;") #{taller.tallerista_universidad || 'Institución'}
                            else 
                                 span.font-bold Tallerista por confirmar
                    
                    p.text-sm.mb-4.flex-grow(style="font-size: 0.8rem; line-height: 1.4;")= taller.descripcion
                    
                    div.mt-auto
                        if estaInscrito
                            p.text-center.font-bold.text-gray-500.mb-2 Pagado
                            button(
                                type="button" 
                                disabled
                                class="w-full bg-gray-200 text-gray-500 font-bold py-2 px-4 rounded cursor-not-allowed border border-gray-300"
                            ) 
                                i.fas.fa-check.mr-2
                                | Ya Inscrito
                        else if estaLleno
                            p.text-center.font-bold.text-gray-400.mb-2 $#{taller.costo} MXN
                            button(
                                type="button" 
                                disabled
                                class="w-full bg-red-50 text-red-400 font-bold py-2 px-4 rounded cursor-not-allowed border border-red-200 uppercase text-xs tracking-wider"
                            ) 
                                i.fas.fa-times-circle.mr-2
                                | Agotado
                        else
                            p.text-center.font-bold.text-gray-800.mb-2 $#{taller.costo} MXN
                            button(
                                type="button" 
                                onclick=`toggleTaller(${taller.id}, '${taller.nombre}', ${taller.costo}, 'btn-${taller.id}', ${dia})`
                                id=`btn-${taller.id}`
                                class=`btn-select w-full border border-${color}-500 text-${color}-600 hover:bg-${color}-50 font-bold py-2 px-4 rounded transition-colors`
                            ) Seleccionar

        - const colorStyles = ['blue', 'gold', 'green']

        div
            div.text-center.mb-10
                h1(style="font-family: 'Montserrat', sans-serif; color: var(--text); font-weight: 800; font-size: 2rem;") Inscripción a Talleres
                p.mt-2(style="font-family: 'Merriweather', serif; color: #64748b; font-size: 1rem;") 
                    | El registro a los talleres 
                    strong(style="color:#252525" ) no es obligatorio. 
                    br
                    | Solo se podrá elegir 
                    strong(style="color:#252525" ) un taller por día, sujeto a disponibilidad, 
                    | debido a que se imparten de manera simultánea.
                    br
                    | Los talleres 
                    strong(style="color:#252525" ) deberán pagarse únicamente de manera directa en el banco.
                br
                h2.text-gray-900.font-bold Nota
                p.mt-2(style="font-family: 'Merriweather', serif; color: #64748b; font-size: 1rem;") 
                    | En caso de no optar por la inscripción a talleres, no olvides 
                    strong(style="color:#252525" ) generar tu referencia en el apartado Resumen de pago.
                br

            div(class=`max-w-7xl mx-auto grid grid-cols-1 ${talleresCompletos ? 'justify-center' : 'lg:grid-cols-4'} gap-8 items-start relative`)
                
                div(class=`${talleresCompletos ? 'w-full max-w-5xl mx-auto' : 'lg:col-span-3'} order-2 lg:order-1`)
                    
                    if talleresDia1.length > 0
                        div.mb-12
                            div(class="flex flex-col md:flex-row items-center gap-4 border-b-2 pb-4 mb-8" style="border-color: #e5e7eb;")
                                i.fas.fa-calendar-alt.text-3xl(style="color: var(--secondary);")
                                div
                                    h2(class="text-2xl font-bold text-gray-800") Miércoles 18
                                    p.text-sm.text-gray-500 4:00 PM • 3 horas

                            div(class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 justify-items-center")
                                each taller, index in talleresDia1
                                    - let currentColor = colorStyles[index % 3]
                                    +cardTaller(taller, index, currentColor, 1)
                    
                    if talleresDia2.length > 0
                        div.mb-12
                            div(class="flex flex-col md:flex-row items-center gap-4 border-b-2 pb-4 mb-8" style="border-color: #e5e7eb;")
                                i.fas.fa-calendar-alt.text-3xl(style="color: var(--secondary);")
                                div
                                    h2(class="text-2xl font-bold text-gray-800") Jueves 19
                                    p.text-sm.text-gray-500 4:00 PM • 3 horas

                            div(class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 justify-items-center")
                                each taller, index in talleresDia2
                                    - let currentColor = colorStyles[index % 3]
                                    +cardTaller(taller, index, currentColor, 2)

                if !talleresCompletos
                    div(class="lg:col-span-1 order-1 lg:order-2 lg:sticky lg:top-8 z-10")
                        
                        div(class="bg-white shadow-2xl rounded-2xl overflow-hidden border border-gray-100 p-6")
                            
                            div.mb-6.border-b.pb-4
                                h3.text-xl.font-extrabold.text-gray-800.flex.items-center.gap-2
                                    i.fas.fa-shopping-cart
                                    | Resumen de Pago

                            div.mb-4.bg-gray-50.p-3.rounded-lg
                                p.text-xs.font-bold.text-gray-400.uppercase Tipo de Registro
                                p.text-sm.font-bold.text-gray-800.leading-tight.mt-1= usuario.tipo_registro
                                div.flex.justify-between.mt-2
                                    span.text-xs.text-gray-500 Costo Base (según tu registro):
                                    span.font-bold.text-blue-600.text-sm $#{parseFloat(costoBaseVisual).toLocaleString('es-MX', {minimumFractionDigits: 2})}
                            
                            div.mb-4
                                p.text-xs.font-bold.text-gray-400.uppercase.mb-2 Talleres Seleccionados
                                div#lista-talleres-seleccionados.space-y-2(style="max-height: 300px; overflow-y: auto;")
                                    p.text-xs.text-gray-400.italic No has seleccionado nuevos talleres

                            div.border-t.pt-4.mt-4
                                div.flex.justify-between.items-center.mb-2
                                    span.text-gray-600.text-sm Extras:
                                    span#subtotal-talleres.font-medium.text-gray-800 $0.00
                                
                                div.flex.justify-between.items-center
                                    span.text-xl.font-bold.text-gray-900 Total:
                                    span#gran-total.text-2xl.font-extrabold.text-green $#{parseFloat(costoBaseVisual).toLocaleString('es-MX', {minimumFractionDigits: 2})}

                            form(action=`${folder}/user/generar-referencia` method="POST" class="mt-6")
                                input(type="hidden" name="_csrf" value=csrfToken)
                                input(type="hidden" name="talleres_ids" id="input_talleres_ids")
                                
                                button(type="submit" class="w-full bg-green hover:bg-green text-white font-bold py-4 px-4 rounded-xl shadow-lg transition-transform duration-200 transform hover:scale-105 flex justify-center items-center gap-2")
                                    i.fas.fa-file-invoice-dollar
                                    | Generar Referencias

        script(src="https://unpkg.com/aos@2.3.1/dist/aos.js")
        script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
        script.
            AOS.init();
            const costoBaseVisual = #{costoBaseVisual}; 
            const diasYaInscritosDB = [#{diasOcupadosDB.join(',')}]; 
            
            let talleresSeleccionados = []; 

            function toggleTaller(id, nombre, costo, btnId, dia) {
                const btn = document.getElementById(btnId);
                const card = document.getElementById('card-' + id);
                
                const existeIndex = talleresSeleccionados.findIndex(t => t.id === id);
                const yaTieneDiaSeleccionado = talleresSeleccionados.find(t => t.dia === dia);

                if (existeIndex === -1) {
                    if (yaTieneDiaSeleccionado) {
                        Swal.fire({
                            title: "Atención...",
                            text: "Solo puedes seleccionar un taller por día en esta orden.",
                            icon: "warning"
                        });
                        return;
                    }

                    if (diasYaInscritosDB.includes(dia)) {
                        Swal.fire({
                            title: "Conflicto de Horario",
                            text: "Ya tienes un taller registrado e inscrito para este día. No puedes agregar otro.",
                            icon: "error"
                        });
                        return;
                    }

                    talleresSeleccionados.push({ id, nombre, costo, dia });
                    btn.innerText = "Quitar";
                    btn.classList.add('bg-gray-800', 'text-white', 'border-gray-800');
                    btn.classList.remove(`text-${btn.dataset.color}-600`, `border-${btn.dataset.color}-500`); 
                    
                    card.style.border = "2px solid #10b981"; 
                    card.style.transform = "scale(1.02)";
                } else {
                    talleresSeleccionados.splice(existeIndex, 1);
                    btn.innerText = "Seleccionar";
                    btn.classList.remove('bg-gray-800', 'text-white', 'border-gray-800');
                    
                    card.style.border = "none";
                    card.style.transform = "scale(1)";
                }
                actualizarResumen();
            }

            function actualizarResumen() {
                const contenedorLista = document.getElementById('lista-talleres-seleccionados');
                const elSubtotal = document.getElementById('subtotal-talleres');
                const elGranTotal = document.getElementById('gran-total');
                const inputHidden = document.getElementById('input_talleres_ids');

                if(!contenedorLista) return;

                contenedorLista.innerHTML = '';
                let sumaTalleres = 0;

                if (talleresSeleccionados.length === 0) {
                    contenedorLista.innerHTML = '<p class="text-xs text-gray-400 italic">No has seleccionado nuevos talleres</p>';
                } else {
                    talleresSeleccionados.forEach(t => {
                        sumaTalleres += t.costo;
                        const item = document.createElement('div');
                        item.className = 'flex justify-between items-start text-xs border-b border-gray-100 pb-2';
                        item.innerHTML = `
                            <span class="w-2/3 text-gray-700 leading-tight truncate pr-2">${t.nombre}</span>
                            <span class="font-bold text-gray-900">$${t.costo}</span>
                        `;
                        contenedorLista.appendChild(item);
                    });
                }

                const granTotal = costoBaseVisual + sumaTalleres;
                const formatoMoneda = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' });

                elSubtotal.innerText = formatoMoneda.format(sumaTalleres);
                elGranTotal.innerText = formatoMoneda.format(granTotal);
                
                const ids = talleresSeleccionados.map(t => t.id);
                inputHidden.value = JSON.stringify(ids);
            }
