block vars
    - var folder = folder || ''

block contenido
    div.min-h-screen.flex.items-center.justify-center.bg-gray-50.py-12.px-4
        .max-w-xl.w-full.bg-white.shadow-lg.rounded-xl.p-8

            .text-center.mb-6
                h1.text-2xl.font-extrabold.text-gray-800.uppercase
                    | Subir Comprobante de pago
                p.mt-2.text-sm.text-gray-500
                    | Adjunta el archivo requerido para continuar.

            .mb-6
                label(
                    for="referencia"
                    class="block text-sm font-semibold text-gray-700 mb-2"
                )
                    | Referencia
                input#referencia(
                    type="text"
                    name="referencia"
                    placeholder="Ej. TRANSF-123456"
                    required
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                )

            form#miDropzone(
                action="/aviso/upload"
                method="POST"
                enctype="multipart/form-data"
                class="dropzone border-2 border-dashed border-gray-300 rounded-lg p-6 bg-gray-50 hover:bg-gray-100 transition"
            )
                .dz-message.text-center
                    p.text-gray-600.font-medium
                        | Arrastra tu archivo aquí
                    p.text-sm.text-gray-400
                        | o haz clic para seleccionarlo
                    p.text-xs.text-gray-400.mt-2
                        | Formatos permitidos: PDF, JPG, PNG

            .mt-6.flex.justify-end
                button(
                    type="button"
                    class="px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg shadow-md hover:bg-blue-700 transition"
                )
                    | Continuar

    script(src="https://unpkg.com/aos@2.3.1/dist/aos.js")
    script.
        AOS.init();
