extends ../layouts/includes/index

block vars
    - var stepActivo = 'referencia'
    - var avisoFirmado = avisoFirmado || null;
    - var folder = folder || ''

block contenido
    link(rel="stylesheet" href="https://unpkg.com/dropzone@5/dist/min/dropzone.min.css")
    style.
        @media print {
            @page { margin: 0; size: auto; }
            body * { visibility: hidden; }
            #area-impresion, #area-impresion * { visibility: visible; }
            #area-impresion {
                position: absolute !important;
                left: 50% !important;
                top: 35% !important;
                transform: translate(-50%, -50%) !important;
                width: 90% !important;
                max-width: 500px !important;
                height: auto !important;
                min-height: 0 !important;
                margin: 0 !important;
                padding: 0 !important;
                background-color: white !important;
                border: 1px solid #ccc !important;
                border-radius: 20px !important;
                display: block !important;
            }
            #area-impresion > div { height: auto !important; flex-grow: 0 !important; }
            .no-print { display: none !important; }
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

    div.py-1.px-4(class="min-h-[85vh]")
            div(class="grid grid-cols-3 gap-4")
            if cobros.length > 0
                div.text-center
                    h1(style="font-family: 'Montserrat', sans-serif; color: var(--text); font-weight: 800; font-size: 2rem;") Referencias de pago
                    p.mt-2(style="font-family: 'Merriweather', serif; color: #64748b; font-size: 1rem;") 
                        | Aquí encontrarás las referencias de pago generadas por tus inscripciones al congreso y talleres seleccionados.
                    br
                    h2.text-gray-900.font-bold Importante
                    p.mt-2(style="font-family: 'Merriweather', serif; color: #64748b; font-size: 1rem;")
                        | El  
                        strong.txt-blue pago del congreso 
                        | deberá realizarse exclusivamente mediante 
                        strong(style="color:#252525" ) depósito o transferencia 
                        | en la cuenta 
                        strong.text-blue-900 BBVA. 
                        br
                        | El 
                        strong.txt-green pago de los talleres 
                        |deberá generarse por separado, utilizando las cuentas indicadas en la 
                        strong.txt-green ficha de pago 
                        | correspondiente.
                        br
                        strong(style="color:#252525" ) Para que el pago del taller sea validado es indispensable haber realizado el pago del congreso. 
                        br
                        | Recuerda subir las fichas de pago en este mismo apartado para su validación.
                    
                    
                    
                br
                div.flex.flex-wrap.justify-center.gap-2.w-full
                    each cobro in cobros
                        div.ficha-card.shadow-xl.overflow-hidden.relative.flex.flex-col.w-full.flex-shrink-0.border.border-gray-200(id=`ficha-${cobro.id}` class="md:w-[450px]" style="border-radius: 20px;")
                            
                            div.bg-gray-100.text-gray900.p-5.text-center.relative
                                div.absolute.top-4.left-4
                                    img(src=`${folder}/img/logo.png`, alt="AMMFEN Logo", style="width: 50px;")
                                if cobro.concepto === 'Congreso'
                                    h1.font-bold.text-xl.uppercase.txt-blue.tracking-wider= `${cobro.concepto} AMMFEN`
                                else
                                    h1.font-bold.text-xl.uppercase.txt-green.tracking-wider= `${cobro.concepto} AMMFEN`
                                p.text-gray-900.text-xs.mt-1 #{new Date().toLocaleDateString('es-MX')}

                            div.p-6.flex-grow.flex.flex-col.gap-6.bg-white
                                div.text-center.border-b.border-gray-100.pb-4
                                    p.text-gray-400.uppercase.font-bold.tracking-wide.mb-1(class="text-[10px]") Titular de la Referencia
                                    h2.text-lg.font-bold.text-gray-800.uppercase.leading-tight #{usuario.nombre} #{usuario.apellido_paterno}
                                        
                                div.bg-white.p-4.rounded-lg.border.border-gray-100
                                    div.flex.justify-between.items-start.mb-2
                                        span.bg-blue-100.text-blue-800.font-bold.px-2.py-1.rounded.uppercase(class="text-[16px]")= cobro.concepto
                                        span.font-extrabold.text-xl.text-gray-800 $#{parseFloat(cobro.total).toLocaleString('es-MX', {minimumFractionDigits: 2})}
                                    p.text-xs.text-gray-600.leading-relaxed.text-justify #{cobro.detalle}

                                div.border-2.border-dashed.border-gray-300.rounded-lg.p-4
                                    p.text-center.text-gray-400.uppercase.font-bold.mb-3(class="text-[10px]") Instrucciones de Pago

                                    if cobro.nombre === 'OTRO'
                                        div.text-center.mb-2
                                            h3.font-bold.text-gray-800.mb-1 Pago en Ventanilla (Multibanco)
                                            p.text-xs.text-gray-500 Presentar los siguientes datos según su banco:
                                            - const bancosList = JSON.parse(cobro.descripcion)
                                            div.space-y-2.mt-3
                                                each banco in bancosList
                                                    div.flex.justify-between.items-center.bg-gray-100.p-2.rounded.text-xs
                                                        span.font-bold.text-gray-700= banco.b
                                                        span.font-mono.text-gray-900= banco.c
                                            div.mt-4.text-center
                                                p.text-gray-400(class="text-[10px]") Referencia General
                                                p.font-mono.font-bold.text-lg= cobro.cuenta
                                    else
                                        div.text-center
                                            h3.font-bold.text-blue-900.text-lg.mb-1= cobro.nombre
                                            p.text-xs.text-gray-500.italic.mb-4= cobro.descripcion
                                            div.space-y-2
                                                if cobro.cuenta
                                                    div.flex.justify-between.border-b.border-gray-100.pb-1
                                                        span.text-xs.text-gray-500 Cuenta:
                                                        span.text-sm.font-mono.font-bold= cobro.cuenta
                                                if cobro.clabe
                                                    div.flex.justify-between.border-b.border-gray-100.pb-1
                                                        span.text-xs.text-gray-500 CLABE:
                                                        span.text-sm.font-mono.font-bold= cobro.clabe
                                                if cobro.rfc
                                                    div.flex.justify-between.border-b.border-gray-100.pb-1
                                                        span.text-xs.text-gray-500 RFC:
                                                        span.text-sm.font-mono.font-bold= cobro.rfc
                                        
                                                        
                                //- AQUI ESTABA EL ERROR: Cambiado de cobros (plural) a cobro (singular)
                                if cobro.comprobante_subido != 'Si'
                                    div.p-4.bg-white.border-t.border-gray-100.no-print
                                        div.grid.grid-cols-2.gap-3
                                            button(type="button" onclick=`imprimirFicha('ficha-${cobro.id}')` class="w-full bg-gray-800 hover:bg-gray-700 text-white font-bold py-3 px-2 rounded-xl shadow transition-transform hover:scale-105 text-sm flex justify-center items-center gap-2")
                                                    i.fas.fa-print
                                                    span Imprimir

                                            button(type="button" onclick=`abrirModal('modal-${cobro.id}')` class="w-full bg-green text-white font-bold py-3 px-2 rounded-xl shadow transition-transform hover:scale-105 text-sm flex justify-center items-center gap-2")
                                                    i.fas.fa-upload
                                                    span Subir
                                else
                                    div.p-4.bg-green-50.border-t.border-green-100.no-print.flex.flex-col.items-center.justify-center
                                        div.flex.items-center.gap-2.text-green-700.mb-1
                                            i.fas.fa-check-circle.text-xl
                                            span.font-bold.text-lg ¡Listo!
                                        p.text-xs.text-green-600 Comprobante enviado a revisión
                                        br
                                        button(type="button" onclick=`borrarPago('${cobro.id}')` class="w-full bg-white text-gray-800 font-bold py-3 px-2 rounded-xl shadow transition-transform hover:scale-105 text-sm flex justify-center items-center gap-2")
                                                i.fas.fa-close
                                                span Borrar pago

                        div(id=`modal-${cobro.id}` class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true")
                            div.flex.items-end.justify-center.min-h-screen.pt-4.px-4.pb-20.text-center(class="sm:block sm:p-0")
                                div(class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true" onclick=`cerrarModal('modal-${cobro.id}')`)
                                span(class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true") &#8203;
                                
                                div(class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg w-full")
                                    div.bg-white.px-4.pt-5.pb-4(class="sm:p-6 sm:pb-4")
                                        div(class="sm:flex sm:items-start")
                                            div(class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full")
                                                h3.text-lg.leading-6.font-medium.text-gray-900#modal-title Subir Comprobante
                                                
                                                div.mt-4
                                                    p.text-sm.text-gray-500.mb-4 Completa los datos y sube tu comprobante.

                                                    div.grid.grid-cols-1.gap-4.mb-4
                                                        div
                                                            label.block.text-sm.font-bold.text-gray-700.mb-1(for=`fecha-${cobro.id}`) Fecha de Pago
                                                            input(
                                                                type="date" 
                                                                id=`fecha-${cobro.id}`
                                                                class="shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-gray-300 rounded-md p-2 border"
                                                                required
                                                            )
                                                        div
                                                            label.block.text-sm.font-bold.text-gray-700.mb-1(for=`transaccion-${cobro.id}`) No. de Transacción / Folio
                                                            input(
                                                                type="text" 
                                                                id=`transaccion-${cobro.id}`
                                                                placeholder="Ej. 12345678"
                                                                class="shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-gray-300 rounded-md p-2 border"
                                                                required
                                                            )
                                                    form.dropzone.border-2.border-dashed.border-blue-300.rounded-lg.bg-blue-50(action="/" id=`dropzone-${cobro.id}` style="min-height: 150px;")
                                                        div.dz-message(data-dz-message)
                                                            span.text-warning.font-bold Arrastra tu archivo aquí
                                                            br
                                                            span.text-xs.text-gray-400 (O haz clic para seleccionar)

                                    div.bg-white.px-4.py-3(class="sm:px-6 sm:flex sm:flex-row-reverse gap-2")
                                        button(type="button" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-green text-base font-medium text-white focus:outline-none sm:ml-3 sm:w-auto sm:text-sm" onclick=`procesarSubida('${cobro.id}')`)
                                            | Enviar Comprobante
                                        button(type="button" class="mt-3 w-full inline-flex justify-center rounded-md border bg-wrong shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 focus:outline-none sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm" onclick=`cerrarModal('modal-${cobro.id}')`)
                                            | Cancelar

                div.mt-8.mx-auto(style="max-width: 750px;")
                        div.border.border-yellow-500.rounded-xl.p-5.bg-white.shadow-sm.relative.overflow-hidden
                            div.absolute.top-0.left-0.w-1.h-full.bg-yellow-500
                            div.flex.items-start.gap-4
                                div.bg-yellow-100.p-3.rounded-full.flex-shrink-0.mt-1
                                    i.fas.fa-info-circle.text-yellow-600.text-lg
                                    
                                div.text-left
                                    p.text-gray-700.text-sm.leading-relaxed
                                        strong.block.text-gray-900.mb-2 Atención!
                                        | Si el pago realizado es por transferencia electrónica, favor de agregar su nombre y apellido en el concepto. De lo contrario no podremos identificar su pago y validar su inscripción.
                                        br
                                        br
                                        | En caso de realizar el pago en ventanilla bancaria, 7Eleven u OXXO es indispensable subir una foto clara del comprobante con su nombre completo escrito para su validación.
                div.mt-8.mx-auto(style="max-width: 750px;")
                        div.border.border-yellow-500.rounded-xl.p-5.bg-white.shadow-sm.relative.overflow-hidden
                            div.absolute.top-0.left-0.w-1.h-full.bg-yellow-500
                            div.flex.items-start.gap-4
                                div.bg-yellow-100.p-3.rounded-full.flex-shrink-0.mt-1
                                    i.fas.fa-info-circle.text-yellow-600.text-lg
                                    
                                div.text-left
                                    p.text-gray-700.text-sm.leading-relaxed
                                        strong.text-gray-900.mb-2 Información de Facturación
                                        p Para solicitar su factura, envíe sus documentos fiscales o régimen fiscal como está dado de alta, método, forma de pago y el uso del CFDI:
                                        
                                        div.mt-3.flex.flex-col.gap-3
                                            a.text-indigo-600.font-semibold.text-xs.flex.items-center(href="mailto:congresoammfen2026@outlook.com" target="_blank") 
                                                i.fas.fa-chevron-right.text-gray-400.mr-2.text-xs
                                                | congresoammfen2026@outlook.com
            else
                div.mt-8.mx-auto(style="max-width: 750px;")
                    div.bg-white.p-8.rounded-lg.shadow-lg.border-t-4.border-yellow-500.text-center
                        div.text-yellow-500.text-5xl.mb-4
                            i.fas.fa-file-invoice
                        h2.text-xl.font-bold.text-gray-800.mb-2 Sin Historial
                        p.text-gray-600.mb-6 Aún no has generado ninguna referencia de pago.
                        a(href=`${folder}/user/talleres` class="inline-block bg-gray-800 text-white px-6 py-3 rounded-lg font-bold  transition") Ir a Inscripciones
            
    script(src="https://unpkg.com/dropzone@5/dist/min/dropzone.min.js")
    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
    
    script.
        const token = "#{csrfToken}"; 
        const folder = "#{folder}";
        Dropzone.autoDiscover = false;
        const dropzones = {};

        document.addEventListener('DOMContentLoaded', function() {
            const forms = document.querySelectorAll('.dropzone');
            
            forms.forEach(form => {
                const id = form.id.split('-')[1]; 
                
                dropzones[id] = new Dropzone(`#${form.id}`, {
                    url: `${folder}/user/subir-comprobante/${id}`,
                    headers: {
                        'CSRF-Token': token
                    },
                    autoProcessQueue: false,
                    maxFiles: 1,
                    acceptedFiles: "image/*,application/pdf",
                    addRemoveLinks: true,
                    dictDefaultMessage: "Arrastra tu archivo aquí",
                    dictRemoveFile: "Quitar archivo",
                    dictMaxFilesExceeded: "Solo puedes subir un archivo a la vez"
                });

                dropzones[id].on("sending", function(file, xhr, formData) {
                    formData.append("_csrf", token);
                    formData.append("id_cobro", id);
                });

                dropzones[id].on("success", function(file, response) {
                    Swal.fire('¡Éxito!', 'Comprobante subido correctamente', 'success').then(() => {
                        window.location.reload();
                    });
                });

                dropzones[id].on("error", function(file, errorMessage) {
                    let mensaje = 'Hubo un problema al subir el archivo';
                    if (typeof errorMessage === 'object' && errorMessage.error) {
                        mensaje = errorMessage.error;
                    } else if (typeof errorMessage === 'string') {
                        mensaje = errorMessage;
                    }
                    console.error(errorMessage);
                    Swal.fire('Error', mensaje, 'error');
                });
            });
        });

        function borrarPago(id_cobro){
            Swal.fire({
                title: '¿Estás seguro?',
                text: "Esta acción eliminará tu comprobante",
                icon: 'warning',
                showCancelButton: true,
                cancelButtonColor: 'rgb(166, 68, 68)',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`${folder}/user/borrar-pago/${id_cobro}`, {
                        headers: {
                            'CSRF-Token': token
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if(data.success) {
                            Swal.fire('¡Eliminado!', 'Tu comprobante ha sido eliminado.', 'success').then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire('Error', data.error || 'No se pudo eliminar el comprobante', 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        Swal.fire('Error', 'Ocurrió un error al eliminar el comprobante', 'error');
                    });
                }
            });
        }

        window.abrirModal = function(id) {
            const modal = document.getElementById(id);
            if(modal) modal.classList.remove('hidden');
        }

        window.cerrarModal = function(id) {
            const modal = document.getElementById(id);
            if(modal) modal.classList.add('hidden');
        }

        function procesarSubida(id) {
            const fecha = document.getElementById(`fecha-${id}`).value;
            const transaccion = document.getElementById(`transaccion-${id}`).value;
            if(!fecha || !transaccion) {
                alert("Por favor ingresa la fecha y el número de transacción");
                return;
            }

            const myDropzone = Dropzone.forElement(`#dropzone-${id}`);
            if (myDropzone.getQueuedFiles().length === 0) {
                alert("Por favor adjunta el archivo del comprobante");
                return;
            }

            myDropzone.on('sending', function(file, xhr, formData) {
                formData.append('fecha_pago', fecha);
                formData.append('no_transaccion', transaccion);
            });

            myDropzone.processQueue();
        }

        window.imprimirFicha = function(idElemento) {
            const fichaSeleccionada = document.getElementById(idElemento);
            if(!fichaSeleccionada) return;
            const idOriginal = fichaSeleccionada.id;
            fichaSeleccionada.id = 'area-impresion';
            window.print();
            fichaSeleccionada.id = idOriginal;
        }
        
        document.addEventListener('contextmenu', event => event.preventDefault());
        document.onkeydown = function(e) {
            if(e.keyCode == 123) return false;
            if(e.ctrlKey && e.shiftKey && (e.keyCode == 'I'.charCodeAt(0) || e.keyCode == 'C'.charCodeAt(0) || e.keyCode == 'J'.charCodeAt(0))) return false;
            if(e.ctrlKey && e.keyCode == 'U'.charCodeAt(0)) return false;
        }