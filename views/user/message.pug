extends ../layouts/includes/index

block vars
    - var stepActivo = "chat"

block contenido
    div(class="max-w-4xl mx-auto mt-10 bg-white rounded-2xl shadow-lg overflow-hidden")

        div(class="bg-blue-600 text-white px-6 py-4 flex items-center justify-between")
            h2.text-lg.font-bold
                i.fas.fa-comments.mr-2
                | Chat de Soporte
            span.text-sm.opacity-80 En línea

        div#chat-mensajes(
            class="p-6 h-96 overflow-y-auto bg-gray-50 space-y-4"
        )

        form#chat-form(class="p-4 border-t flex gap-2")
            input(type="hidden" id="csrfToken" value=csrfToken)

            input#mensaje(
                type="text"
                placeholder="Escribe tu mensaje..."
                class="flex-1 px-4 py-3 rounded-xl border focus:outline-none"
                autocomplete="off"
            )
            button(
                type="submit"
                class="bg-blue-600 text-white px-6 rounded-xl hover:bg-blue-700"
            ) Enviar

    script(src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.6.0/axios.min.js")
    script.
        const contenedor = document.getElementById('chat-mensajes');
        const form = document.getElementById('chat-form');
        const input = document.getElementById('mensaje');
        const csrfToken = document.getElementById('csrfToken').value;

        axios.defaults.withCredentials = true;
        
        // Cargar mensajes
        async function cargarMensajes() {
            const res = await axios.get('/user/api/mensajes');
            contenedor.innerHTML = '';

            res.data.forEach(m => {
                const div = document.createElement('div');
                div.className = m.emisor_rol === 'user'
                    ? 'text-right'
                    : 'text-left';

                div.innerHTML = `
                    <div class="inline-block px-4 py-2 rounded-xl ${
                        m.emisor_rol === 'user'
                        ? 'bg-blue-600 text-white'
                        : 'bg-gray-200 text-gray-800'
                    }">
                        ${m.mensaje}
                    </div>
                `;
                contenedor.appendChild(div);
            });

            contenedor.scrollTop = contenedor.scrollHeight;
        }

        // Enviar mensaje
        form.addEventListener('submit', async e => {
            e.preventDefault();

            if (!input.value.trim()) return;

            await axios.post(
                '/user/api/mensajes',
                { texto: input.value },
                {
                    headers: {
                    'X-CSRF-Token': csrfToken
                    }
                }
            );


            input.value = '';
            cargarMensajes();
        });

        cargarMensajes();
