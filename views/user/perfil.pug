extends ../layouts/includes/index

block vars
    - var stepActivo = 'perfil' 
    - var avisoFirmado = avisoFirmado || null;
    - var folder = folder || ''

block contenido
    //- Manejo robusto del objeto usuario
    - var userExists = typeof usuario !== 'undefined' && usuario !== null
    - var u = userExists ? (Array.isArray(usuario) ? usuario[0] : usuario) : {}
    
    //- Fallbacks de datos
    - var nombre = u.nombre || "Sin nombre"
    - var apellido = u.apellido || "Sin apellido"
    - var email = u.email || "Sin correo"
    - var codigo = u.codigo || u.usuario || "Sin codigo"
    - var rol = u.rol || "Sin rol"

    section.w-full.mx-auto.my-10.px-6.py-8h-full
        .banner-motion(aria-hidden="true").h-full.z-0
            span.orb.orb-a
            span.orb.orb-b
            span.orb.orb-c
            .banner-grid
        
        .mt-8.mx-auto(style="width: 100%;").h-full.z-20
            
            //- Header de Perfil: Estilo Expediente Académico
            div(class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-10").max-w-5xl.mx-auto.z-100
                div(class="h-32 w-full bg-[var(--secondary)] flex items-end px-8 ").z-100
                    div(class="translate-y-1/2 p-1 bg-white rounded-full shadow-sm")
                        div(class="h-32 w-32 rounded-full border-4 flex items-center justify-center bg-[var(--primary)]" style="border-color: white;")
                            i.fas.fa-user.text-5xl(style="color:white;")

                div(class="space-y-4 p-8 pt-20")
                            div
                                label(class="block text-xs font-medium text-gray-400 uppercase") Código
                                p(class="text-slate-700 font-medium") #{codigo}
                
                div(class=" pb-8 px-8 flex flex-col md:flex-row justify-between items-start gap-6")
                    div
                        h1(class="text-3xl font-bold text-slate-800") #{nombre} #{apellido}
                        p(class="text-slate-500 flex items-center gap-2") 
                            span(class="px-2 py-0.5 bg-indigo-50 text-indigo-700 rounded text-xs font-bold uppercase track-wider") #{rol}
                            span |
                            | #{email}
                    
                    div(class="flex flex-wrap gap-3")
                        a(href=`${folder}/auth/olvide-password` class="px-5 py-2.5 text-sm font-semibold rounded-lg transition-all border border-gray-200 flex items-center gap-2 hover:bg-[var(--accent)]" style="color: var(--text);")
                            | Olvidaste tu contraseña?
                        
                        form(action=`${folder}/auth/cerrar-sesion` method="GET")
                            if csrfToken
                                input(type="hidden" name="_csrf" value=csrfToken)
                            button(type="submit" class="px-5 py-2.5 text-sm font-semibold rounded-lg transition-all flex items-center gap-2 text-white shadow-sm hover:bg-[var(--accent)] bg-[var(--wrong)]" )
                                | Cerrar Sesión

                


            //- Footer de perfil
            div(class="mt-12 pt-8 border-t border-gray-100 flex flex-col items-center")
                a(href=`${folder}/user/aviso` class="group flex items-center gap-2 text-slate-400 hover:text-indigo-500 transition-colors text-sm")
                    i.fas.fa-shield-alt(class="group-hover:animate-pulse")
                    span Ver aviso de privacidad y protección de datos personales