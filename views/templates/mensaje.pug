block vars
    - var folder = folder || ''
head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Iniciar Sesión - Congreso AMMFEN

    //- 1. ESTILOS DEL NAVBAR Y FOOTER (Tu CSS personalizado)
    link(rel="stylesheet", href=`${folder}/css/styles.css`)
    link(rel="stylesheet", href=`${folder}/css/mobile.css`)
    link(rel="icon" href=`${folder}/img/icon.ico`)

    //- 2. ESTILOS DEL FORMULARIO (Tailwind CSS)
    //- Nota: Si ya tienes Tailwind instalado localmente, usa tu archivo build. 
    //- Si no, dejo el CDN aquí para asegurar que el formulario se vea bien ahora mismo.
    script(src="https://cdn.tailwindcss.com") 

    //- Librerías extra (Iconos y AOS)
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    link(href="https://unpkg.com/aos@2.3.1/dist/aos.css", rel="stylesheet")

    //- Un pequeño ajuste para que Tailwind no rompa tu Navbar (reset conflict)
    style.
        /* Asegura que el navbar siempre esté arriba */
        .navbar { z-index: 50; } 
        /* Ajuste para que el formulario no quede oculto detrás del navbar fijo */
        body { padding-top: 80px; } 

body.bg-gray-50
    include ../layouts/navbar.pug
    //- block contenido 
    div.pt-10
        h1.text-5xl.my-10.font-extrabold.text-center XXXIX CONGRESO NACIONAL 
            span.font-normal AMMFEN
        h5(data-aos="fade-up", data-aos-delay="700").text-center Conectar, crear e innovar en nutrición
            h3(data-aos="fade-up", data-aos-delay="400").text-center GUADALAJARA | 2026
            h4(data-aos="fade-up", data-aos-delay="500").text-center Del 18 al 20 de marzo de 2026

        div(data-aos="zoom-in", data-aos-delay="600" class="separator-line w-24 h-1 bg-amber-600 mx-auto my-6 rounded")


        h2.text-center.text-2xl.font-bold.my-20= pagina

    div(class="rounded-lg max-w-md mx-auto").mb-20.p-6(data-aos="fade-up", data-aos-delay="800")
        p.py-2.px-5.rounded-lg.w-full.font-bold.text-center.text-white.uppercase(class= error ? 'bg-red-500' : 'bg-green')= mensaje
        if !error
    
    //- --- INCLUDE FOOTER ---
    include ../layouts/footer.pug    

//- Scripts necesarios para que el Navbar y animaciones funcionen igual que en el login
script(src="https://unpkg.com/aos@2.3.1/dist/aos.js")
script.
    AOS.init();