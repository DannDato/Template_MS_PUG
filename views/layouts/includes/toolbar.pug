block vars
    - var folder = folder || ''

//- Lógica de usuario
- var whoIs = stepActivo === 'panel' || stepActivo === 'talleresGest' || stepActivo === 'corredores' || stepActivo === 'controlAcceso' || stepActivo === 'editar' ? 'admin' : 'user'

- 
    var stepMap = {
        'info': 1,
        'talleres': 2,
        'referencia': 3,
        'acceso': 4,
        'carrera': 5
    }
    var currentStep = stepMap[stepActivo] || 0;

//- TOOLBAR
div.flex.justify-between.items-center.mb-8.pb-4.border-b.border-gray-200.relative.h-16
    
    //- IZQUIERDA: LOGO
    div(class=`z-10 relative ${whoIs === 'user' ? 'hidden md:block' : 'block'}`)
        img.banner-logo(
            src=`${folder}/img/icon.ico`, 
            alt="AMMFEN Logo", 
            style="width:50px;",
            onClick=`window.location.href=${whoIs === 'user' ? `'${folder}/info/extra-info'` : `'${folder}/admin/panel'`}`
        )

    //- LÓGICA DE NAVEGACIÓN
    case stepActivo
        when 'aviso'
            - prevLink = null
            - nextLink = `${folder}/info/extra-info`
        when 'info'
            - prevLink = `${folder}/user/aviso`
            - nextLink = `${folder}/user/talleres`
        when 'talleres'
            - prevLink = `${folder}/info/extra-info`
            - nextLink = `${folder}/user/referencia`
        when 'referencia'
            - prevLink = `${folder}/user/talleres`
            - nextLink = `${folder}/user/acceso`
        when 'acceso'
            - prevLink = `${folder}/user/referencia`
            - nextLink = `${folder}/user/carrera`
        when 'carrera'
            - prevLink = `${folder}/user/acceso`
            - nextLink = null
        when 'perfil'
            - prevLink = `${folder}/user/acceso`
            - nextLink = null

    if stepActivo !== 'panel' && stepActivo !== 'talleresGest' && stepActivo !== 'corredores' && stepActivo !== 'controlAcceso' && stepActivo !== 'editar'
        
        div(class="absolute left-1/2 transform -translate-x-1/2 flex justify-center items-center w-full md:w-auto z-0")
            
            div(class="flex items-center gap-2 md:gap-4")
                
                //- Flecha izquierda
                a(
                    href= prevLink ? prevLink : 'javascript:void(0)'
                    class=`transition-colors duration-300 p-2 
                    ${prevLink ? 'text-gray-400 hover:text-gray-600 cursor-pointer' : 'text-gray-200 cursor-default pointer-events-none'}`
                ) 
                    i.fa-solid.fa-chevron-left(class="text-xl md:text-2xl font-bold")

                //- Bolitas
                div(class="flex-shrink-0")
                    .progress-container.gap-2(style="margin-bottom:0;")
                        
                        a.step(href=avisoFirmado ? `${folder}/info/extra-info` : '' class=(currentStep > 1 ? 'completed' : (currentStep === 1 ? 'active' : '')) style="width:32px; height:32px; font-size:14px;") 
                            if currentStep > 1
                                i.fa-solid.fa-check
                            else
                                | 1
                        
                        a.step(href=avisoFirmado ? `${folder}/user/talleres` : '' class=(currentStep > 2 ? 'completed' : (currentStep === 2 ? 'active' : '')) style="width:32px; height:32px; font-size:14px;")
                            if currentStep > 2
                                i.fa-solid.fa-check
                            else
                                | 2

                        a.step(href=avisoFirmado ? `${folder}/user/referencia` : '' class=(currentStep > 3 ? 'completed' : (currentStep === 3 ? 'active' : '')) style="width:32px; height:32px; font-size:14px;")
                            if currentStep > 3
                                i.fa-solid.fa-check
                            else
                                | 3

                        a.step(href=avisoFirmado ? `${folder}/user/acceso` : '' class=(currentStep > 4 ? 'completed' : (currentStep === 4 ? 'active' : '')) style="width:32px; height:32px; font-size:14px;")
                            if currentStep > 4
                                i.fa-solid.fa-check
                            else
                                | 4

                        a.step(href=avisoFirmado ? `${folder}/user/carrera` : '' class=(currentStep === 5 ? 'active' : '') style="width:32px; height:32px; font-size:14px;")
                            | 5

                //- Flecha derecha
                a(
                    href= (nextLink && avisoFirmado) ? nextLink : 'javascript:void(0)'
                    class=`transition-colors duration-300 p-2 
                    ${(nextLink && avisoFirmado) ? 'text-gray-400 hover:text-gray-600 cursor-pointer' : 'text-gray-200 cursor-default pointer-events-none'}`
                ) 
                    i.fa-solid.fa-chevron-right(class="text-xl md:text-2xl font-bold")
            

    div.z-10.relative.flex.items-center.gap-6.ml-auto
        if whoIs === 'admin'
            button.text-gray-700.hover_text-primary.transition.focus_outline-none.p-2(
                type="button" 
                onclick="toggleMenu()"
                class="hover_scale-110 transform duration-200"
            )
                i.fas.fa-bars.text-3xl
        else

            a.profile-link.flex.items-center.gap-2.transition(href=`${folder}/user/perfil`)
                i.fas.fa-user-circle.text-3xl.text-gray-700
                span.text-sm.font-medium.text-gray-600.hidden.md_block Admin

//- MENÚ ADMIN (Igual que antes)
if whoIs === 'admin'
    div#menu-overlay.fixed.inset-0.bg-black.bg-opacity-50.z-40.hidden.transition-opacity.duration-300(
        onclick="toggleMenu()"
        style="backdrop-filter: blur(2px);"
    )
    div#side-menu.fixed.inset-y-0.right-0.z-50.w-64.bg-white.shadow-2xl.transform.translate-x-full.transition-transform.duration-300.ease-in-out.flex.flex-col
        
        div.p-6.border-b.border-gray-100.flex.justify-between.items-center
            span.font-bold.text-gray-800 Menú
            button.text-gray-500.hover_text-red-500.transition(onclick="toggleMenu()")
                i.fas.fa-times.text-xl

        nav.flex-grow.p-4.flex.flex-col.gap-2
            a.flex.items-center.gap-3.px-4.py-3.rounded-lg.text-gray-700.hover_bg-blue-50.hover_text-blue-600.transition(href=`${folder}/admin/panel`)
                i.fas.fa-chart-line.w-6.text-center
                span.font-medium Panel General
            a.flex.items-center.gap-3.px-4.py-3.rounded-lg.text-gray-700.hover_bg-blue-50.hover_text-blue-600.transition(href=`${folder}/admin/talleres`)
                i.fas.fa-chalkboard-teacher.w-6.text-center
                span.font-medium Talleres
            a.flex.items-center.gap-3.px-4.py-3.rounded-lg.text-gray-700.hover_bg-blue-50.hover_text-blue-600.transition(href=`${folder}/admin/corredores`)
                i.fas.fa-running.w-6.text-center
                span.font-medium Corredores
            a.flex.items-center.gap-3.px-4.py-3.rounded-lg.text-gray-700.hover_bg-blue-50.hover_text-blue-600.transition(href=`${folder}/admin/acceso`)
                i.fas.fa-id-badge.w-6.text-center
                span.font-medium Control de acceso

        div.p-4.border-t.border-gray-100
            a.flex.items-center.gap-3.px-4.py-3.rounded-lg.text-red-600.hover_bg-red-50.transition(href=`${folder}/auth/cerrar-sesion`)
                i.fas.fa-sign-out-alt.w-6.text-center
                span.font-medium Cerrar Sesión

if whoIs === 'user'
    div.relative 
        div(class="fixed bottom-5 h-['40px'] w-['40px'] right-5 bg-blue text-white rounded-full p-3 z-20")

            a.group.relative.flex.items-center.gap-2.transition(
                href="#"
                onclick="abrirChatUsuario(event, '${usuario.id}')"
            )
                div.relative
                    i.fas.fa-comments.text-3xl.text-gray-700.transition.text-white
                    if mensajesSinLeer = 0
                    span#badge-no-leidos.absolute.-top-2.-right-2.flex.h-5.w-5.items-center.justify-center.rounded-full.bg-red-500.text-xs.font-bold.text-white.border-2.border-white.hidden
                        
                
                span.text-sm.font-medium.text-gray-600.hidden.md_block Mensajes


div#modal-usuario.fixed.inset-0.bg-black.bg-opacity-50.hidden.flex.items-center.justify-center.z-50
    div.bg-white.shadow-2xl.w-full.max-w-6xl.h-5_6.flex.flex-col.transform.transition-all(style="border-radius: 20px; overflow: hidden; height: 90vh;")
        div.bg-gray-100.px-6.py-4.border-b.border-gray-200.flex.justify-between.items-center.flex-shrink-0
            h3.text-lg.font-bold.text-gray-800 Editar Usuario 
            button.text-gray-500.hover_text-red-500.transition(onclick="cerrarModal()")
                i.fas.fa-times.text-xl
        div.flex-grow.bg-gray-50.relative
            div#iframe-loader.absolute.inset-0.flex.items-center.justify-center.bg-white.z-0
                i.fas.fa-spinner.fa-spin.text-4xl.txt-blue
            iframe#modal-iframe.w-full.h-full.relative.z-10(src="" frameborder="0")

div#modal-usuario-chat.fixed.inset-0.bg-black.bg-opacity-50.hidden.flex.items-center.justify-center.z-50
    div(class="bg-white w-full max-w-4xl h-[100vh] md:h-[50vh] lg:h-[50vh] flex flex-col rounded-2xl shadow-2xl overflow-hidden")
        div.bg-white.px-6.py-4.flex.justify-between.items-center.flex-shrink-0
            div
                h3.text-lg.font-bold.text-gray-800 Chat de Soporte
                p.text-xs.text-gray-800 En línea
            button(
                    class="text-gray-300 hover:text-red-300 transition"
                    onclick="cerrarChatModal()"
                )
                i.fas.fa-times.text-xl
        
        div#chat-messages.flex-1.bg-gray-100.p-6.overflow-y-auto.space-y-4
            div.flex.justify-start
                div.bg-white.rounded-xl.px-4.py-2.shadow.max-w-md
                    p.text-sm.text-gray-800 Hola 👋 ¿en qué puedo ayudarte?
        form#chat-form.border-t.bg-white.p-4.flex.items-center.gap-3.flex-shrink-0
            input(action=`${folder}/user/api/mensajes` type="hidden" id="csrfToken" value=csrfToken)

            input#mensaje(
                type="text"
                class="flex-1 border rounded-full px-4 py-2 text-sm focus:outline-none focus:ring"
                placeholder="Escribe un mensaje..."
            )

            button#chat-send(type="submit" class="bg-blue text-white rounded-full px-5 py-2 transition")
                i.fas.fa-paper-plane

    script.
        function toggleMenu() {
            const menu = document.getElementById('side-menu');
            const overlay = document.getElementById('menu-overlay');
            const isClosed = menu.classList.contains('translate-x-full');
            if (isClosed) {
                menu.classList.remove('translate-x-full');
                overlay.classList.remove('hidden');
            } else {
                menu.classList.add('translate-x-full');
                overlay.classList.add('hidden'); 
            }
        }
script.
    function abrirModalUsuario(e, id) {
        e.preventDefault();   
        const modal = document.getElementById('modal-usuario');
        const iframe = document.getElementById('modal-iframe');
        const loader = document.getElementById('iframe-loader');

        loader.classList.remove('hidden');
        iframe.src = `${folder}/user/message`;
        modal.classList.remove('hidden');
    }

    function cerrarModal() {
        const modal = document.getElementById('modal-usuario');
        const iframe = document.getElementById('modal-iframe');
        modal.classList.add('hidden');
        setTimeout(() => { iframe.src = ''; }, 300);
    }

    //- function abrirChatUsuario(e, usuarioId) {
    //-     document.getElementById('modal-usuario-chat')
    //-         .classList.remove('hidden');

    //-     cargarMensajes(usuarioId);
    //- }

    //- function cerrarChatModal() {
    //-     document.getElementById('modal-usuario-chat')
    //-         .classList.add('hidden');
    //- }
script(src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.6.0/axios.min.js")
script.
    const folder2 = "#{folder}";
    const MENSAJE_AUTOMATICO = `
        Gracias por comunicarte con el Congreso AMMFEN 2026 🎓 En un momento uno de nuestros asesores se pondrá en contacto contigo.`;
    const AUTO_REPLY_KEY = 'ammfen2026_auto_reply_sent';
    const contenedor = document.getElementById('chat-messages');
    const form = document.getElementById('chat-form');
    const input = document.getElementById('mensaje');
    const csrfToken = document.getElementById('csrfToken').value;

    axios.defaults.withCredentials = true;

    async function cargarMensajes() {
        const res = await axios.get(`${folder2}/user/api/mensajes`);
        contenedor.innerHTML = '';
        console.log('Mensajes recibidos del servidor:', res.data);
        if(!res.data.mensajes || res.data.mensajes.length === 0) {
            contenedor.innerHTML = `
                <div class="px-4 py-2 rounded-xl max-w-md bg-white text-gray-800 shadow"> 
                    Hola 👋 No tienes mensajes aún. ¿En qué puedo ayudarte? 
                </div> `
            return;
        }
        else{
            res.data.mensajes.forEach(m => {
                const wrapper = document.createElement('div');
                wrapper.className = `flex ${m.emisor_rol === 'user' ? 'justify-end' : 'justify-start'}`;

                wrapper.innerHTML = `
                    <div class="px-4 py-2 rounded-xl max-w-md 
                        ${m.emisor_rol === 'user'
                            ? 'bg-blue text-white'
                            : m.emisor_rol === 'bot'
                                ? 'bg-green-100 text-green-800 border border-green-300'
                                : 'bg-white text-gray-800 shadow'
                        }">
                        ${m.mensaje}
                    </div>
                `;

                contenedor.appendChild(wrapper);
            });
        }

        contenedor.scrollTop = contenedor.scrollHeight;
    }

    let respuestaAutomaticaEnviada = false;
    form.addEventListener('submit', async e => {
        e.preventDefault();
        if (!input.value.trim()) return;

        await axios.post(
            `${folder2}/user/api/mensajes`,
            { texto: input.value },
            { headers: { 'X-CSRF-Token': csrfToken } }
        );

        input.value = '';
        cargarMensajes();

        //- if (!respuestaAutomaticaEnviada) {
        //-     respuestaAutomaticaEnviada = true;

        //-     setTimeout(async () => {
        //-         await axios.post(
        //-             '/user/api/mensajes',
        //-             {
        //-                 texto: MENSAJE_AUTOMATICO,
        //-                 emisor_rol: 'bot'
        //-             },
        //-             { headers: { 'X-CSRF-Token': csrfToken } }
        //-         );

        //-         cargarMensajes();
        //-     }, 1200); 
        //- }
    });
    async function cargarMensajesNoLeidos() {
        try {
            const res = await fetch(`${folder2}/user/mensajes-no-leidos`, {
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            if (!res.ok) return;

            const data = await res.json();
            console.log('Número de mensajes no leídos:', data.no_leidos);
            const badge = document.getElementById('badge-no-leidos');

            if (data.no_leidos > 0) {
                badge.textContent = data.no_leidos;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }

        } catch (error) {
            console.error('Error cargando mensajes no leídos:', error);
        }
    }
    document.addEventListener('DOMContentLoaded', () => {
        cargarMensajesNoLeidos();
    });

    function abrirChatUsuario() {
        document.getElementById('modal-usuario-chat').classList.remove('hidden');
        cargarMensajes();
    }

    function cerrarChatModal() {
        document.getElementById('modal-usuario-chat').classList.add('hidden');
    }