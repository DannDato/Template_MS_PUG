block vars
    - var folder = folder || ''
    - var systemName = process.env.SYSTEM_NAME || ''

header(class="sticky top-0 z-50 w-full bg-white/80 backdrop-blur-md border-b border-gray-100 p-0 px-10")
    div(class=" mx-auto w-full")
        div(class="flex justify-between items-center h-16 w-full")
            //- Navegación Desktop
            nav(class="hidden md:flex items-center space-x-1")
                - 
                    var links = [
                        { id: 'inicio', label: 'Inicio', icon: 'fa-home', url: '/user/' },
                        //- { id: 'perfil', label: 'Mi Perfil', icon: 'fa-user-circle', url: '/user/perfil' }
                    ]

                each link in links
                    - var active = stepActivo === link.id
                    //- Definimos las clases como strings simples para evitar errores de parseo en el atributo class
                    - var linkStyle = active ? 'bg-[var(--banner)] text-[var(--primary)] opacity-100' : 'text-[var(--text)] opacity-70 hover:bg-[var(--accent)]'
                    - var iconStyle = active ? 'scale-110' : 'opacity-50 group-hover:scale-110'

                    a(
                        href=`${folder}${link.url}`
                        class=`px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-200 flex items-center gap-2 group ${linkStyle}`
                    )
                        //- i(class=`fas ${link.icon} transition-transform ${iconStyle}`)
                        span #{link.label}

            //- titulo
            div(class="flex items-center justify-between")
                //- Sección del Título (Izquierda)
                div(class="flex items-center")
                    a(href=`${folder}/user/` class="group flex items-center gap-3 transition-transform active:scale-95")                        
                        h1(class="font-bold text-xl md:text-2xl tracking-tight text-slate-800 px-10")
                            | 
                            span(style="color: var(--primary);") #{systemName}

                //- Sección de Perfil (Derecha)
                div(class="flex items-center gap-4")
                    a(
                        href=`${folder}/user/perfil` 
                        class="relative group"
                        title="Ir a mi perfil"
                    )
                        div(class="h-11 w-11 rounded-full p-0.5 transition-all duration-300 group-hover:shadow-md group-hover:border-[var(--primary)]" style="border-color: var(--banner);")
                            div(class="w-full h-full rounded-full flex items-center justify-center overflow-hidden")
                                if u && u.avatar
                                    img(src=u.avatar class="w-full h-full object-cover")
                                else
                                    i.fas.fa-user-circle.text-2xl(style="color: var(--primary);")
                        
                        //- Indicador de estado (opcional)
                        span(class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 border-2 border-white rounded-full")
        //- Mobile nav (Corregido para que no sea hijo del flex principal si quieres que esté abajo)
        div(class="md:hidden flex justify-around py-2 border-t border-gray-50")
            - var inicioActivo = stepActivo === 'inicio'
            - var perfilActivo = stepActivo === 'perfil'

            a(href=`${folder}/user/` class="flex flex-col items-center gap-1")
                i(class=`fas fa-home ${inicioActivo ? 'text-[var(--primary)]' : 'text-gray-400'}`)
                span(class=`text-[10px] font-medium ${inicioActivo ? 'text-[var(--primary)]' : 'text-gray-400'}`) Inicio

            a(href=`${folder}/user/perfil` class="flex flex-col items-center gap-1")
                i(class=`fas fa-user ${perfilActivo ? 'text-[var(--primary)]' : 'text-gray-400'}`)
                span(class=`text-[10px] font-medium ${perfilActivo ? 'text-[var(--primary)]' : 'text-gray-400'}`) Perfil
    