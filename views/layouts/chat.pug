.floating-chat
  i.fa.fa-comments(aria-hidden="true")
  .chat
    .header
      span.title what's on your mind?
      button
        i.fa.fa-times(aria-hidden="true")

    ul.messages
      li.other asdasdasasdasdasasdasdasasdasdasasdasdasasdasdasasdasdas
      li.other Are we dogs??? 🐶
      li.self no... we're human
      li.other are you sure???
      li.self yes.... -___-
      li.other if we're not dogs.... we might be monkeys 🐵
      li.self i hate you
      li.other don't be so negative! here's a banana 🍌
      li.self ......... -___-

    .footer
      .text-box(contenteditable="true" disabled="true")
      button#sendMessage send
