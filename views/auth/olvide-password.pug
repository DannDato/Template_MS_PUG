block vars
    - var folder = folder || ''
head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Iniciar Sesión

    //- 1. ESTILOS DEL NAVBAR Y FOOTER (Tu CSS personalizado)
    link(rel="stylesheet", href=`${folder}/css/styles.css`)
    link(rel="stylesheet", href=`${folder}/css/mobile.css`)
    link(rel="icon" href=`${folder}/img/icon.ico`)
    //- 2. ESTILOS DEL FORMULARIO (Tailwind CSS)
    //- Nota: Si ya tienes Tailwind instalado localmente, usa tu archivo build.
    //- Si no, dejo el CDN aquí para asegurar que el formulario se vea bien ahora mismo.
    script(src="https://cdn.tailwindcss.com")

    //- Librerías extra (Iconos y AOS)
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    link(href="https://unpkg.com/aos@2.3.1/dist/aos.css", rel="stylesheet")

    //- Un pequeño ajuste para que Tailwind no rompa tu Navbar (reset conflict)
    style.
        /* Asegura que el navbar siempre esté arriba */
        .navbar { z-index: 50; }
        /* Ajuste para que el formulario no quede oculto detrás del navbar fijo */

body.bg-gray-50
    include ../layouts/navbar.pug

    //- --- CONTENIDO RECUPERAR CONTRASEÑA ---
    section.banner.login-banner
      .banner-motion(aria-hidden="true")
        span.orb.orb-a
        span.orb.orb-b
        span.orb.orb-c
        .banner-grid

      div(data-aos="fade-up" style="z-index: 20;").container.mx-auto.px-4.py-12
        .mt-8.mx-auto.login-form-container
            .bg-white.py-8.px-4.shadow-lg.rounded-lg(style="width: 100%;")
                form.space-y-5(action=`${folder}/auth/olvide-password` method="POST" novalidate)
                    input(type="hidden" name="_csrf" value=csrfToken)
                    div
                        h3.font-bold.text-center.text-xl Olvidaste tu contraseña?
                        p.text-justify.text-gray-600.mt-2.text-sm
                        | Para iniciar sesión en este sistema es necesario que utilices tus
                        | credenciales de la Universidad de Guadalajara,
                        | Si olvidaste tu contraseña, será necesario que solicites el cambio directamente en la plataforma
                        | <a href="https://siiau.udg.mx/" target="_blank" class="text-blue-500 hover:underline">SIIAU.</a>
                        | <br><br>
                        | Una vez que hayas cambiado tu contraseña en SIIAU, podrás iniciar sesión normalmente con tu nuevo password.
                        | Si tienes algún problema para iniciar puedes ponerte en contacto con la coordinación de tecnologías para el aprendizaje del centro universitario de ciencias de la salud.
                        //- BOTONES DE NAVEGACIÓN
                    div.flex.items-center.justify-between
                        a.text-gray-600.text-xs.hover_text-indigo-500(href=`${folder}/auth/login`) Iniciar sesión
                    a(href="https://siiau.udg.mx/" target="_blank" class="w-full text-white font-bold py-3 cursor-pointer rounded-md transition-colors login bg-green block text-center") Ir a SIIAU
    //- --- INCLUDE FOOTER ---
    include ../layouts/footer.pug

//- Scripts necesarios para que el Navbar y animaciones funcionen igual que en el login
script(src="https://unpkg.com/aos@2.3.1/dist/aos.js")
script.
    AOS.init();