block vars
    - var folder = folder || ''
    - var error = error || false
    - var errorMessage = errorMessage || ''
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Iniciar Sesión

    //- 1. ESTILOS DEL NAVBAR Y FOOTER (Tu CSS personalizado)
    link(rel="stylesheet", href=`${folder}/css/styles.css`)
    link(rel="stylesheet", href=`${folder}/css/mobile.css`)
    link(rel="icon" href=`${folder}/img/icon.ico`)

    //- 2. ESTILOS DEL FORMULARIO (Tailwind CSS)
    //- Nota: Si ya tienes Tailwind instalado localmente, usa tu archivo build.
    //- Si no, dejo el CDN aquí para asegurar que el formulario se vea bien ahora mismo.
    script(src="https://cdn.tailwindcss.com")

    //- Librerías extra (Iconos y AOS)
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    link(href="https://unpkg.com/aos@2.3.1/dist/aos.css", rel="stylesheet")

    //- Un pequeño ajuste para que Tailwind no rompa tu Navbar (reset conflict)
    style.
      /* Asegura que el navbar siempre esté arriba */
      .navbar { z-index: 50; }

  body.bg-gray-100
    //- --- INCLUDE NAVBAR ---
    include ../layouts/navbar.pug



    //- --- CONTENIDO LOGIN ---
    section.w-full.mx-auto.my-10.px-6.py-8.bg-gray-100.rounded-lg.h-auto
        .banner-motion(aria-hidden="true")
            span.orb.orb-a
            span.orb.orb-b
            span.orb.orb-c
            .banner-grid
        h2.text-2xl.font-bold.mb-6.text-center Iniciar Sesión
        
        .mt-8.mx-auto.bg-white.py-8.px-10.shadow-lg.rounded-3xl.max-w-5xl(style="width: 100%;")
            .grid.grid-cols-1.gap-5(class="md:grid-cols-2")
                form.space-y-5(method="POST" action=`${folder}/auth/login` novalidate).w-full
                    input(type="hidden" name="_csrf" value=csrfToken)

                    //- CAMPO CODIGO
                    div
                        label.block.text-sm.uppercase.text-gray-500.mb-3.font-bold(for="codigo") Código

                        - const errorCodigo = errores ? errores.find(e => e.path === 'codigo') : null

                        input#codigo.w-full.px-3.py-3.border.rounded-md.placeholder-gray-400(
                            placeholder="Tu codigo de UdG (números)"
                            name="codigo"
                            class= errorCodigo ? 'border-red-500' : 'border-gray-300'
                        )
                        if errorCodigo
                            p.text-red-500.text-xs.mt-1.font-bold= errorCodigo.msg

                    //- CAMPO PASSWORD
                    div
                        label.block.text-sm.uppercase.text-gray-500.mb-3.font-bold(for="password") Contraseña

                        - const errorPass = errores ? errores.find(e => e.path === 'password') : null

                        input#password.w-full.px-3.py-3.border.rounded-md.placeholder-gray-400(
                            placeholder="Tu contraseña de siiau"
                            type="password"
                            name="password"
                            class= errorPass ? 'border-red-500' : 'border-gray-300'
                        )
                        if errorPass
                            p.text-red-500.text-xs.mt-1.font-bold= errorPass.msg

                    if error
                        p.text-red-500.text-sm.mb-4 #{errorMessage}
                    p.text-white.text-sm.font-bold.p-2.bg-red-500.mb-4.hidden(id="errorUrlMessage") Codigo o contraseña incorrectos. Por favor, verifica tus credenciales e intenta nuevamente.
                    div.flex.items-center.justify-between
                        //- a.text-gray-600.text-xs.hover_text-indigo-500(href=`${folder}/auth/registro`) ¿No tienes cuenta? Crear una
                        a.text-gray-600.text-xs.hover_text-indigo-500(href=`${folder}/auth/olvide-password`) Olvide mi contraseña

                    input(class="w-full text-white font-bold py-3 cursor-pointer rounded-md transition-colors login bg-green" type="submit" value="Iniciar Sesión")
                .flex.justify-center.mx-auto
                    img(src=`${folder}/img/icon.png`, alt="Login Image", style="width: 350px; height: auto;")

    //- INCLUDE NAVBAR
    include ../layouts/footer.pug

    //- SCRIPTS NECESARIOS PARA EL NAVBAR
    script(src="https://unpkg.com/aos@2.3.1/dist/aos.js")
    script.
        AOS.init();
         const parametros = new URLSearchParams(window.location.search);
  
        // Cachamos variables específicas
        const error = parametros.get('error');       // "true"

        if(error === 'true') {
            // Aquí puedes mostrar un mensaje de error personalizado o realizar alguna acción
            //- alert('Error al iniciar sesión. Por favor, verifica tus credenciales e intenta nuevamente.');
            document.getElementById('errorUrlMessage').classList.remove('hidden');
            document.getElementById('errorUrlMessage').classList.add('block');
        }
