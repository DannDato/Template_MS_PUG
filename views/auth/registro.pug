block vars
    - var folder = folder || ''
doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Registro

    //- 1. ESTILOS DEL NAVBAR Y FOOTER
    link(rel="stylesheet", href=`${folder}/css/styles.css`)
    link(rel="stylesheet", href=`${folder}/css/mobile.css`      )
    link(rel="icon" href=`${folder}/img/icon.ico`)

    //- 2. ESTILOS TAILWIND (Formulario)
    script(src="https://cdn.tailwindcss.com")

    //- Iconos y Animaciones
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    link(href="https://unpkg.com/aos@2.3.1/dist/aos.css", rel="stylesheet")

    //- Ajuste para evitar solapamiento con navbar
    style.
      .navbar { z-index: 50; }

  body.bg-gray-50
    //- INCLUDE NAVBAR
    include ../layouts/navbar.pug

    //- --- CONTENIDO REGISTRO ---
    section.banner.login-banner
      .banner-motion(aria-hidden="true")
        span.orb.orb-a
        span.orb.orb-b
        span.orb.orb-c
        .banner-grid

      div(data-aos="fade-up" style="z-index: 20;").container.mx-auto.px-4.py-12
        h1.text-4xl.my-10.font-extrabold.text-center Nuevo
            span.font-normal.px-2 registro

        //- ALERTAS DE ERROR GENERAL
        if errores
            div(class="login-form-container mx-auto my-4")
                each error in errores
                    p.bg-red-600.text-white.uppercase.text-xs.text-center.p-2.mb-1.font-bold= error.msg

        .mt-8.mx-auto.login-form-container
            .bg-white.py-8.px-4.shadow-lg.rounded-lg(style="width: 100%;")
                form.space-y-5(method="POST" action=`${folder}/auth/registro` novalidate)
                    input(type="hidden" name="_csrf" value=csrfToken)

                    //- CAMPO NOMBRE
                    div
                        label.block.text-sm.uppercase.text-gray-500.mb-3.font-bold(for="nombre") Tu nombre
                        input#nombre.w-full.px-3.py-3.border.border-gray-300.rounded-md.placeholder-gray-400(
                            placeholder="Nombre completo"
                            type="text"
                            name="nombre"
                            value= usuario ? usuario.nombre : ''
                        )
                        p.text-xs.text-gray-500.mt-1.italic * Es importante: Registrar tu nombre tal cual deseas que aparezca en tu constancia de asistencia.

                    //- CAMPO EMAIL
                    div
                        label.block.text-sm.uppercase.text-gray-500.mb-3.font-bold(for="email") Correo de registro
                        input#email.w-full.px-3.py-3.border.border-gray-300.rounded-md.placeholder-gray-400(
                            placeholder="Tu correo electrónico"
                            type="email"
                            name="email"
                            value= usuario ? usuario.email : ''
                        )
                        p.text-xs.text-gray-500.mt-1.italic * No olvides tu correo y contraseña ya que lo utilizaras durante todo el proceso.

                    //- CAMPO PASSWORD
                    div
                        label.block.text-sm.uppercase.text-gray-500.mb-3.font-bold(for="password") Contraseña
                        input#password.w-full.px-3.py-3.border.border-gray-300.rounded-md.placeholder-gray-400(
                            placeholder="Mínimo 6 caracteres"
                            type="password"
                            name="password"
                        )

                    //- CAMPO REPETIR PASSWORD
                    div
                        label.block.text-sm.uppercase.text-gray-500.mb-3.font-bold(for="repetir_password") Repetir contraseña
                        input#repetir_password.w-full.px-3.py-3.border.border-gray-300.rounded-md.placeholder-gray-400(
                            placeholder="Repite tu password"
                            type="password"
                            name="repetir_password"
                        )

                    //- BOTONES DE NAVEGACIÓN
                    div.flex.items-center.justify-between
                        a.text-gray-600.text-xs.hover_text-indigo-500(href=`${folder}/auth/login`) ¿Ya tienes cuenta? Inicia sesión
                        a.text-gray-600.text-xs.hover_text-indigo-500(href=`${folder}/auth/olvide-password`) Olvide mi contraseña

                    //- SUBMIT
                    input(class="w-full text-white font-bold py-3 cursor-pointer rounded-md transition-colors register" type="submit" value="Crear Cuenta")
    //- INCLUDE NAVBAR
    include ../layouts/footer.pug
    //- SCRIPTS
    script(src="https://unpkg.com/aos@2.3.1/dist/aos.js")
    script.
        AOS.init();