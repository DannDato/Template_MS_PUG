                div.flex.flex-wrap.gap-2.justify-center
                    each pago in pagos
                        if pago.tipo === 'imagen'
                            a(
                                href=`${folder}/uploads/comprobantes/${pago.archivo}`
                                target="_blank"
                            )
                                button(type="button" class="flex items-center text-red-600 text-sm font-medium bg-red-50 px-3 py-2 tracking-wide rounded-full cursor-pointer")
                                    svg.w-4.mr-2.fill-current(
