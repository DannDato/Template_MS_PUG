extends ../layouts/includes/index
block vars
    - var folder = folder || ''
    - var stepActivo = "editar"
block contenido
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css">
    h1(class="text-center font-bold") Nombre - #{user_name}
    div(class="grid grid-cols-1 md:grid-cols-2 gap-8")
        if infoExtra && !infoExtra.length > 0
            div
                form(
                    method="POST"
                    action=`${folder}/user/extra-info`
                    class="space-y-6"
                    
                )
                input(type="hidden" name="_csrf" value=csrfToken)
                
                div
                    label.block.text-sm.font-medium.text-gray-700(for="lugar")
                        | Lugar de origen
                    input#lugar.w-full.px-3.py-3.border.rounded-md.placeholder-gray-400(
                        type="text"
                        name="lugar"
                        required
                        disabled
                        value = infoExtra ? infoExtra.lugar : ''
                        placeholder="Ciudad / País"
                    )

                //- Edad
                div
                    label.block.text-sm.font-medium.text-gray-700(for="edad")
                        | Edad
                    input#edad.w-full.px-3.py-3.border.rounded-md.placeholder-gray-400(
                        type="text"
                        name="edad"
                        required
                        disabled
                        value = infoExtra ? infoExtra.edad : ''
                        placeholder="Ej. 25"
                    )

                //- Numero de telefono
                div
                    label.block.text-sm.font-medium.text-gray-700(for="telefono")
                        | Télefono
                    input#edad.w-full.px-3.py-3.border.rounded-md.placeholder-gray-400(
                        type="text"
                        value = infoExtra ? infoExtra.telefono : ''
                        name="telefono"
                        required
                        disabled
                        placeholder="Ej. +52 333 123 4567"
                        
                    )

                //- Contacto de emergencia
                div
                    label.block.text-sm.font-medium.text-gray-700(for="emergencia")
                        | Contacto de emergencia
                    input#contacto_emergencia.w-full.px-3.py-3.border.rounded-md.placeholder-gray-400(
                        type="text"
                        value = infoExtra ? infoExtra.emergencia : ''
                        name="emergencia"
                        required
                        disabled
                        placeholder="Nombre y teléfono"
                    )

                //- Sexo

                div
                    .form-group
                        label(for="sexo") Sexo
                        select#sexo.w-full.px-3.py-3.border.rounded-md.placeholder-gray-400(
                            name="sexo"
                            required
                            disabled
                        )
                            option(value="") Selecciona una opción
                            option(
                                value="Masculino"
                                selected=infoExtra && infoExtra.sexo === "Masculino"
                            ) Masculino
                            option(
                                value="Femenino"
                                selected=infoExtra && infoExtra.sexo === "Femenino"
                            ) Femenino
                            option(
                                value="Otro"
                                selected=infoExtra && infoExtra.sexo === "Otro"
                            ) Prefiero no decirlo
                //- Ocupación
                div
                    .form-group
                        label(for="ocupacion") Ocupación
                        select#ocupacion.w-full.px-3.py-3.border.rounded-md.placeholder-gray-400(
                            name="ocupacion_id"
                            required
                            disabled
                        )
                            option(value="") Selecciona una ocupación
                            each ocupacion in ocupaciones
                                option(
                                    value=ocupacion.id
                                    data-ocupacion=ocupacion.nombre
                                    selected=infoExtra && infoExtra.ocupacion_id == ocupacion.id
                                )= ocupacion.nombre

                //- Universidad
                div
                    .form-group
                        label(for="universidad") Universidad
                        select#universidad.w-full.px-3.py-3.border.rounded-md.placeholder-gray-400(
                            name="universidad_id"
                            required
                            disabled
                        )
                            option(value="") Selecciona tu universidad
                            each universidad in universidades
                                option(
                                    value=universidad.id
                                    data-descuento=universidad.descuento
                                    data-afiliado=universidad.afiliado
                                    selected=infoExtra && infoExtra.universidadId == universidad.id
                                )= universidad.nombre

                p#descuento-info.text-sm.text-green-600.hidden

                div
                    .form-group
                        label(for="carrera") Carrera
                        select#carrera.w-full.px-3.py-3.border.rounded-md.placeholder-gray-400(
                            name="carrera_id"
                            required
                            disabled
                        )
                            option(value="") Selecciona tu carrera
                            each carrera in carreras
                                option(
                                    value=carrera.id
                                    selected=infoExtra && infoExtra.carrera_id == carrera.id
                                )= carrera.nombre
                div#otra-universidad-container.hidden
                    label.block.text-sm.font-medium.text-gray-700(for="otra_universidad")
                        | Especifica tu universidad
                    input#otra_universidad.w-full.px-3.py-3.border.rounded-md(
                        type="text"
                        name="otra_universidad"
                        value= infoExtra ? infoExtra.otra_universidad : ''
                        placeholder="Nombre de la universidad"
                        disabled
                    )
                div#otra-carrera-container.hidden
                    label.block.text-sm.font-medium.text-gray-700(for="otra_carrera")
                        | Especifica tu Carrera
                    input#otra_carrera.w-full.px-3.py-3.border.rounded-md(
                        type="text"
                        name="otra_carrera"
                        value= infoExtra ? infoExtra.otra_carrera : ''
                        placeholder="Nombre de la carrera"
                )
                

                
        else
            div.rounded-xl.p-10.text-center.border.border-dashed(style="background-color: #f5f5f5; border-color: var(--primary);")
                    i.fas.fa-chalkboard.text-4xl.mb-3(style="color: var(--primary); opacity: 0.5;")
                    p(style="color: var(--text);") No tiene información por el momento.
        div.space-y-6
            div.border.rounded-lg.p-4.bg-gray-50.h-50
                h3.text-sm.font-semibold.text-gray-700.mb-3.text-center Archivos Probatorios
                div.flex.flex-wrap.gap-2.justify-center
                    each archivo in archivos
                        if archivo.tipo === 'imagen'
