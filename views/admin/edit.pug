            div(class="max-w-5xl mx-auto")
            
                h2.text-3xl.font-light.mb-8.text-center(style="color: var(--text);") Talleres y Actividades del usuario

                if talleres && talleres.length > 0
                    div(class="grid grid-cols-1 md:grid-cols-2 gap-10 mx-5")
                        each taller in talleres
                            div.rounded-2xl.shadow-lg.p-6.border.relative.overflow-hidden.transition-transform.hover.scale-105.duration-300(style="background-color: var(--surface); border-color: var(--banner);")
                                //- Barra decorativa superior (Gradiente con tus colores)
                                div.absolute.top-0.left-0.w-full.h-1(style="background: linear-gradient(to right, var(--primary), var(--secondary));")
                                
                                div.flex.justify-between.items-start
                                    h3.font-bold.text-lg.mb-2.leading-tight(style="color: var(--dark);")= taller.nombre
                                
                                p.text-xs.mb-4.leading-relaxed.h-10.overflow-hidden(style="color: var(--text); opacity: 0.8;")= taller.descripcion

                                div.space-y-2.pt-4(style="border-top: 1px solid var(--banner);")
                                    //- Fecha y Hora
                                    div.flex.items-center.text-sm(style="color: var(--text);")
                                        i.far.fa-calendar-alt.w-6.text-center(style="color: var(--accent);")
                                        - const fecha = new Date(taller.fecha_hora)
                                        span.capitalize= fecha.toLocaleDateString('es-MX', {weekday:'long', day:'numeric', month:'long'}) + ' ' + fecha.toLocaleTimeString('es-MX', {hour: '2-digit', minute:'2-digit'}) + ' hrs'
                                    
                                    //- Tallerista (si existe)
                                    if taller.tallerista_nombre
                                        div.flex.items-center.text-sm(style="color: var(--text);")
                                            i.fas.fa-user-tie.w-6.text-center(style="color: var(--primary);")
                                            span= taller.tallerista_nombre
                                    
                                    //- Duración
                                    div.flex.items-center.text-sm(style="color: var(--text);")
                                        i.far.fa-clock.w-6.text-center(style="color: var(--secondary);")
                                        span Duración: #{taller.duracion} hrs

                else
                    //- Estado vacío
                    div.rounded-xl.p-10.text-center.border.border-dashed(style="background-color: #f5f5f5; border-color: var(--primary);")
                        i.fas.fa-chalkboard.text-4xl.mb-3(style="color: var(--primary); opacity: 0.5;")
                        p(style="color: var(--text);") No tiene talleres inscritos por el momento.
    br
    .grid.grid-cols-2.gap-4
        div.mt-14
            button(
            onclick="resetUser("+usuario.id+")" 
            type="button" 
            class="w-full bg-gray-300 text-black font-bold py-4 px-4 rounded-xl shadow-lg transition-transform duration-200 transform hover:scale-4 flex justify-center items-center gap-2"
            ) Reiniciar registro
        div.mt-14
            button#btn-validar(
                type="button"
                data-user-id=usuario.id
                class="w-full bg-green text-white font-bold py-4 px-4 rounded-xl shadow-lg transition-transform duration-200 transform hover:scale-4 flex justify-center items-center gap-2"
            )
                | Validar usuario
    br
    br
    


    script(src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js")
    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
    script.
        GLightbox({
            touchNavigation: true,
            loop: true
        });
        const folder = "#{folder}";
        const btnValidar = document.getElementById('btn-validar');
        const csrfToken = document
            .querySelector('meta[name="csrf-token"]')
            .getAttribute('content');

        async function resetUser(id){
            Swal.fire({
                title: '¿Reiniciar registro?',
                text: 'Esta acción eliminará toda la información del usuario y le permitirá registrarse nuevamente. Esta acción no se puede deshacer.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#afafaf',
                cancelButtonColor: '#0E7490',
                confirmButtonText: 'Sí, reiniciar',
                cancelButtonText: 'Cancelar'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Confirmación requerida...',
                        text: 'ESTA ACCIÓN NO SE PUEDE DESHACER. ¿ESTÁS SEGURO DE QUE QUIERES REINICIAR EL REGISTRO DE ESTE USUARIO?',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#dc6767',
                        cancelButtonColor: '#dc6767',
                        cancelButtonText: 'Cancelar',
                        confirmButtonText: 'Sí, reiniciar',
                    }).then(async (result) => {
                        if (result.isConfirmed) {
                            const response = await fetch(`${folder}/admin/panel/usuario/${id}/reiniciar`, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'CSRF-Token': csrfToken 
                                }
                            });
                            const data = await response.json();
                            await Swal.fire({
                                title: data.title,
                                text:  data.message,
                                icon: data.type,
                                confirmButtonColor: '#16a34a'
                            });
                            if (data.type === 'success') {
                                location.reload(); 
                            }
                        }
                    });
                }
            });
        }
        btnValidar?.addEventListener('click', async () => {
            const userId = btnValidar.dataset.userId;
            console.log('Validar usuario ID:', userId);

            const result = await Swal.fire({
                title: 'Atención!',
                text: 'Esta acción validará los documentos y pagos del usuario, asignará un folio y confirmará su acceso al congreso.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#16a34a',
                cancelButtonColor: '#dc2626',
                confirmButtonText: 'Sí, validar',
                cancelButtonText: 'Cancelar'
            });

            if (!result.isConfirmed) return;

            // Loader
            Swal.fire({
                title: 'Validando...',
                text: 'Por favor espera',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            try {
                const response = await fetch(`${folder}/admin/panel/usuario/${userId}/validar`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'CSRF-Token': csrfToken 
                    }
                });

                const data = await response.json();
                let mensajeTexto = data.mensaje + (data.folio ? '. Folio asignado: ' +data.folio: '');
                if (response.ok) {
                    await Swal.fire({
                        title: '¡Validado!',
                        text:  mensajeTexto,
                        icon: 'success',
                        confirmButtonColor: '#16a34a'
                    });

                    location.reload(); 
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: data.mensaje || 'No se pudo validar',
                        icon: 'error'
                    });
                }

            } catch (error) {
                console.error(error);
                Swal.fire({
                    title: 'Error de conexión',
                    text: 'Intenta nuevamente',
                    icon: 'error'
                });
            }
        });