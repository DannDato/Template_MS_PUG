extends ../layouts/includes/index

block vars
    - var folder = folder || ''
    - var stepActivo = "chats"

block contenido
    div.bg-white.shadow-2xl.w-full.max-w-6xl.flex.flex-col(
        style="border-radius: 20px; height: 90vh; overflow: hidden;"
    )
        div.bg-blue-600.px-6.py-4.flex.justify-between.items-center.flex-shrink-0
            div
                h3.text-lg.font-bold.text-white Chat con Usuario
                p.text-xs.text-blue-100 En línea
            button.text-white.hover_text-red-300.transition(onclick="cerrarModal()")
                i.fas.fa-times.text-xl

        div#chat-messages.flex-grow.bg-gray-100.p-6.overflow-y-auto.space-y-4
            div.flex.items-start
                div.bg-white.rounded-xl.p-4.shadow.max-w-md
                    p.text-sm.text-gray-800 Hola 👋 ¿en qué puedo ayudarte?

            div.flex.items-end.justify-end
                div.bg-blue-500.rounded-xl.p-4.shadow.max-w-md
                    p.text-sm.text-white Necesito ayuda con mi cuenta

        div.border-t.bg-white.p-4.flex.items-center.gap-3.flex-shrink-0
            input#chat-input(
                type="text"
                class="w-full border rounded-full px-4 py-2 text-sm focus:outline-none focus:ring"
                placeholder="Escribe un mensaje..."
            )
            button#chat-send(class="bg-blue-600 text-white rounded-full px-5 py-2 hover:bg-blue-700 transition")
                i.fas.fa-paper-plane
