extends ../layouts/includes/index

block vars
    - var folder = folder || ''
    - var stepActivo = "corredores"

block contenido
    script(src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js")

    div(data-aos="fade-up")

        div.mb-6.text-center.md_text-left
            h2.text-2xl.font-bold.mb-2(style="color: var(--text); font-family: 'Montserrat', sans-serif;") 
                i.fas.fa-running.mr-2
                | Total de corredores: #{totalCorredores}
            p.text-gray-500 Aquí tienes la lista de participantes que han confirmado su asistencia a la carrera.
        
        div.bg-white.rounded-2xl.shadow-lg.overflow-hidden.border.border-gray-100
            div.px-6.py-5.border-b.border-gray-200.flex.flex-col.md_flex-row.items-center.justify-between.gap-4
                div.relative.w-full.max-w-md
                    span.absolute.inset-y-0.left-0.flex.items-center.pl-3.text-gray-400
                        i.fas.fa-search
                    input#buscador.pl-10.pr-4.py-2.bg-gray-50.border.border-gray-200.rounded-xl.text-sm.w-full.focus_outline-none.focus_ring-2.focus_ring-blue-100(
                        type="text" 
                        placeholder="Buscar por nombre o correo..." 
                        onkeyup="filtrarTabla()"
                    )
                    
            div.overflow-x-auto
                table.min-w-full.leading-normal
                    thead
                        tr.bg-gray-50
                            th.px-5.py-3.text-left.text-xs.font-bold.text-gray-500.uppercase.tracking-wider #
                            th.px-5.py-3.text-left.text-xs.font-bold.text-gray-500.uppercase.tracking-wider Participante
                            th.px-5.py-3.text-left.text-xs.font-bold.text-gray-500.uppercase.tracking-wider Contacto
                            th.px-5.py-3.text-center.text-xs.font-bold.text-gray-500.uppercase.tracking-wider Fecha Registro
                    
                    tbody#tabla-inscritos
                        //- Se llena con JS

            div.px-6.py-4.bg-gray-50.border-t.flex.justify-end
                button#btn-excel.bg-green.text-white.px-4.py-2.rounded-lg.font-bold.text-sm.hover_bg-green-700.transition.flex.items-center.gap-2(
                    onclick="descargarExcel()" 
                )
                    i.fas.fa-file-excel
                    span Descargar Lista

    script(src="https://unpkg.com/aos@2.3.1/dist/aos.js")
    script(src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js")
    script(src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/locale/es.min.js")
    
    script.
        AOS.init();
        // Recibimos la lista directa del controller
        const corredoresData = !{JSON.stringify(corredores || [])};
        
        // Inicializamos variable de filtrado con todos los datos
        var inscritosFiltrados = corredoresData;

        // EJECUTAR AL CARGAR
        document.addEventListener('DOMContentLoaded', () => {
            renderizarTabla();
        });

        function renderizarTabla() {
            const tbody = document.getElementById('tabla-inscritos');
            tbody.innerHTML = '';

            const termino = document.getElementById('buscador').value.toLowerCase();
            const datosAMostrar = inscritosFiltrados.filter(u => 
                (u.nombre || '').toLowerCase().includes(termino) || 
                (u.email || '').toLowerCase().includes(termino)
            );

            if (datosAMostrar.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="4" class="px-5 py-10 text-center text-sm text-gray-400">
                            <i class="fas fa-search mb-2 text-xl block text-gray-300"></i>
                            No se encontraron corredores.
                        </td>
                    </tr>`;
                return;
            }

            datosAMostrar.forEach((usuario, index) => {
                const tr = document.createElement('tr');
                tr.className = "bg-white border-b border-gray-100 hover:bg-gray-50 transition duration-150 ease-in-out";

                // Formatear fecha si existe, sino guion
                const fecha = usuario.fecha_registro ? moment(usuario.fecha_registro).format('DD MMM YYYY, h:mm a') : '---';

                tr.innerHTML = `
                    <td class="px-5 py-4 whitespace-nowrap text-sm text-gray-400 font-medium">
                        ${index + 1}
                    </td>
                    
                    <td class="px-5 py-4 whitespace-nowrap">
                        <div class="flex items-center">
                            <div class="flex-shrink-0 w-10 h-10">
                                <div class="w-full h-full rounded-full bg-gray-100 txt-blue flex items-center justify-center text-sm shadow-sm">
                                    <i class="fas fa-running"></i>
                                </div>
                            </div>
                            <div class="ml-4">
                                <p class="text-sm font-bold text-gray-800 leading-tight">${usuario.nombre}</p>
                            </div>
                        </div>
                    </td>
                    
                    <td class="px-5 py-4 whitespace-nowrap text-sm text-gray-500">
                        ${usuario.email}
                    </td>

                    <td class="px-5 py-4 whitespace-nowrap text-center">
                        <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                            ${fecha}
                        </span>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function filtrarTabla() {
            renderizarTabla();
        }

        function descargarExcel() {
            if(!inscritosFiltrados.length) return alert("No hay datos para exportar");
            const data = [
                ["ID", "Nombre Participante", "Email", "Fecha Registro"]
            ];
            inscritosFiltrados.forEach(u => {
                data.push([
                    u.id,
                    u.nombre,
                    u.email,
                    u.fecha_registro ? moment(u.fecha_registro).format('YYYY-MM-DD HH:mm') : ''
                ]);
            });

            var ws = XLSX.utils.aoa_to_sheet(data);
            var wb = XLSX.utils.book_new();
            
            XLSX.utils.book_append_sheet(wb, ws, "Corredores");
            XLSX.writeFile(wb, `Lista_Corredores_AMMFEN.xlsx`);
        }